{
  "realm": "africodeshield",
  "displayName": "AfriCodeShield",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername(undefined) and passwordHistory(5)",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xFrameOptions": "SAMEORIGIN",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains",
    "referrerPolicy": "no-referrer"
  },
  "roles": {
    "realm": [
      {
        "name": "VIEWER",
        "description": "AfriCodeShield: read-only access to dashboards, findings and reports"
      },
      {
        "name": "AUDITOR",
        "description": "AfriCodeShield: launches scans, triages findings, generates reports",
        "composite": true,
        "composites": { "realm": ["VIEWER"] }
      },
      {
        "name": "ADMIN",
        "description": "AfriCodeShield: manages Git connections, scanners, users and settings",
        "composite": true,
        "composites": { "realm": ["AUDITOR"] }
      }
    ]
  },
  "clients": [
    {
      "clientId": "africodeshield-web",
      "name": "AfriCodeShield web UI",
      "description": "Angular SPA: public client, authorization code + PKCE (S256)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "rootUrl": "${ACS_PUBLIC_URL}",
      "baseUrl": "/",
      "redirectUris": ["${ACS_PUBLIC_URL}/*"],
      "webOrigins": ["${ACS_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ACS_PUBLIC_URL}/*",
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "audience-africodeshield-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "africodeshield-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "profile", "roles", "email", "basic"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "${ACS_INITIAL_ADMIN_USERNAME}",
      "enabled": true,
      "emailVerified": false,
      "firstName": "AfriCodeShield",
      "lastName": "Administrator",
      "requiredActions": ["UPDATE_PASSWORD", "CONFIGURE_TOTP"],
      "credentials": [
        {
          "type": "password",
          "value": "${ACS_INITIAL_ADMIN_PASSWORD}",
          "temporary": true
        }
      ],
      "realmRoles": ["ADMIN"]
    }
  ]
}

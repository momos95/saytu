# =============================================================================
# SAYTU - environment. Copy to .env and replace every CHANGE_ME:
#   cp .env.example .env && scripts/generate-secrets.sh >> .env   (or edit by hand)
# Never commit .env.
# =============================================================================

# --- Public URLs (what users type in their browser) ---------------------------
# Behind a TLS reverse proxy use https://audit.example.org and https://sso.example.org
SAYTU_PUBLIC_URL=http://localhost:8080
SAYTU_KEYCLOAK_PUBLIC_URL=http://localhost:8180
SAYTU_HTTP_PORT=8080
SAYTU_KEYCLOAK_PORT=8180

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_DB=saytu
POSTGRES_USER=saytu
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# --- Keycloak ----------------------------------------------------------------------
# Keycloak administration console (master realm). Used only for the first start:
# create a permanent admin, then remove these two values.
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# First SAYTU administrator (realm saytu). The password is temporary:
# Keycloak forces a change and a TOTP enrolment at first login.
SAYTU_INITIAL_ADMIN_USERNAME=admin
SAYTU_INITIAL_ADMIN_PASSWORD=CHANGE_ME

# --- Application -------------------------------------------------------------------
# 32 random bytes, base64. Encrypts Git tokens and webhook secrets at rest (AES-256-GCM).
# Losing it means re-entering every token. Back it up separately from the database.
SAYTU_MASTER_KEY=CHANGE_ME
# Former master keys (comma-separated) kept during a key rotation; tokens are re-encrypted on next use.
SAYTU_PREVIOUS_MASTER_KEYS=
# Publish Swagger UI (/swagger-ui.html) without authentication. Keep false in production.
SAYTU_EXPOSE_API_DOCS=false

# --- Git platforms ------------------------------------------------------------------
# Accept http:// platforms (tokens travel unencrypted). Isolated networks only.
SAYTU_GIT_ALLOW_PLAIN_HTTP=false
# Internal CA or HTTPS inspection proxy (Netskope, Zscaler...): put its certificate (PEM / Base-64 .cer)
# in ./data/ca and rebuild (docker compose build): it is trusted for builds and for Git platforms.
# Optionally point to one of them explicitly, e.g.
# SAYTU_GIT_CA_BUNDLE_IN_CONTAINER=/etc/saytu/ca/corp-ca.pem
SAYTU_GIT_CA_BUNDLE_IN_CONTAINER=
SAYTU_CA_DIR=./data/ca
# Directory of local repositories (LOCAL connections), mounted read-only at /srv/git
SAYTU_LOCAL_REPOS_HOST_DIR=./data/local-repos
# Skip unit tests during `docker compose build` (faster; tests still run with mvn test)
SAYTU_SKIP_TESTS=false
# Outbound HTTP proxy, e.g. -Dhttps.proxyHost=proxy.corp -Dhttps.proxyPort=3128 -Dhttp.nonProxyHosts=*.corp|keycloak
SAYTU_JAVA_PROXY_OPTS=

# --- Scan worker ------------------------------------------------------------------------
# Jobs (repository x branch) run at the same time; each scanner may use the memory set on the
# "Scanners & branches" page, keep the worker's memory limit (6 GB) in mind.
SAYTU_WORKER_MAX_PARALLEL_JOBS=2
# Quota on a checked-out branch (MB)
SAYTU_CHECKOUT_MAX_MB=2048
# Trivy vulnerability database: downloaded and refreshed by the worker (public advisories only, no code
# is sent). Air-gapped site: false, then copy the database by hand (docs/operations.md).
SAYTU_TRIVY_DB_AUTO_UPDATE=true
# Mirror of the database (OCI), e.g. registry.corp/aquasecurity/trivy-db:2. Empty = Trivy's default.
SAYTU_TRIVY_DB_REPOSITORY=
# Proxy for clones and the database download (the worker's git and Trivy), e.g. http://proxy.corp:3128
SAYTU_HTTPS_PROXY=
SAYTU_NO_PROXY=

# --- Optional: local LLM (docker compose --profile ai up -d) ------------------------
SAYTU_OLLAMA_MODEL=qwen2.5-coder:7b

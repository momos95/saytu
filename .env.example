# =============================================================================
# AfriCodeShield - environment. Copy to .env and replace every CHANGE_ME:
#   cp .env.example .env && scripts/generate-secrets.sh >> .env   (or edit by hand)
# Never commit .env.
# =============================================================================

# --- Public URLs (what users type in their browser) ---------------------------
# Behind a TLS reverse proxy use https://audit.example.org and https://sso.example.org
ACS_PUBLIC_URL=http://localhost:8080
ACS_KEYCLOAK_PUBLIC_URL=http://localhost:8180
ACS_HTTP_PORT=8080
ACS_KEYCLOAK_PORT=8180

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_DB=africodeshield
POSTGRES_USER=acs
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# --- Keycloak ----------------------------------------------------------------------
# Keycloak administration console (master realm). Used only for the first start:
# create a permanent admin, then remove these two values.
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# First AfriCodeShield administrator (realm africodeshield). The password is temporary:
# Keycloak forces a change and a TOTP enrolment at first login.
ACS_INITIAL_ADMIN_USERNAME=admin
ACS_INITIAL_ADMIN_PASSWORD=CHANGE_ME

# --- Application -------------------------------------------------------------------
# 32 random bytes, base64. Encrypts Git tokens and webhook secrets at rest (AES-256-GCM).
# Losing it means re-entering every token. Back it up separately from the database.
ACS_MASTER_KEY=CHANGE_ME
# Former master keys (comma-separated) kept during a key rotation; tokens are re-encrypted on next use.
ACS_PREVIOUS_MASTER_KEYS=
# Publish Swagger UI (/swagger-ui.html) without authentication. Keep false in production.
ACS_EXPOSE_API_DOCS=false

# --- Git platforms ------------------------------------------------------------------
# Accept http:// platforms (tokens travel unencrypted). Isolated networks only.
ACS_GIT_ALLOW_PLAIN_HTTP=false
# Internal CA: put PEM files in ./data/ca and point to one of them, e.g.
# ACS_GIT_CA_BUNDLE_IN_CONTAINER=/etc/africodeshield/ca/corp-ca.pem
ACS_GIT_CA_BUNDLE_IN_CONTAINER=
ACS_CA_DIR=./data/ca
# Directory of local repositories (LOCAL connections), mounted read-only at /srv/git
ACS_LOCAL_REPOS_HOST_DIR=./data/local-repos
# Outbound HTTP proxy, e.g. -Dhttps.proxyHost=proxy.corp -Dhttps.proxyPort=3128 -Dhttp.nonProxyHosts=*.corp|keycloak
ACS_JAVA_PROXY_OPTS=

# --- Optional: local LLM (docker compose --profile ai up -d) ------------------------
ACS_OLLAMA_MODEL=qwen2.5-coder:7b

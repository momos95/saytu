<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  SAYTU Checkstyle configuration (Apache-2.0). Checkstyle 14.3.0.
  Focus: conventions and constructs that hurt maintainability or hide bugs. Pure formatting
  (whitespace, indentation, brace placement) is left to formatters and not reported.
  Every module reports with severity "warning": Checkstyle's exit code counts "error" events, which
  would be ambiguous above 253. SAYTU assigns its own severity per module (CheckstyleAdapter).
  No suppression filter is configured: comments or annotations in the audited code cannot hide findings.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <module name="FileLength"><property name="max" value="2000"/></module>
    <module name="LineLength">
        <property name="max" value="160"/>
        <property name="ignorePattern" value="^(package|import) |^\s*\*|https?://"/>
    </module>

    <module name="TreeWalker">
        <!-- probable bugs -->
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="EmptyCatchBlock"/>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>
        <module name="InnerAssignment"/>
        <module name="IllegalInstantiation">
            <property name="classes" value="java.lang.Boolean, java.lang.Integer, java.lang.Long, java.lang.String"/>
        </module>
        <module name="EmptyStatement"/>
        <module name="CovariantEquals"/>
        <module name="SuperClone"/>
        <module name="SuperFinalize"/>
        <module name="ModifiedControlVariable"/>
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="Error, Throwable, java.lang.Error, java.lang.Throwable"/>
        </module>

        <!-- complexity and size -->
        <module name="CyclomaticComplexity"><property name="max" value="15"/></module>
        <module name="BooleanExpressionComplexity"><property name="max" value="4"/></module>
        <module name="NestedIfDepth"><property name="max" value="4"/></module>
        <module name="NestedForDepth"><property name="max" value="3"/></module>
        <module name="NestedTryDepth"><property name="max" value="2"/></module>
        <module name="MethodLength"><property name="max" value="150"/></module>
        <module name="ParameterNumber"><property name="max" value="8"/></module>
        <module name="ReturnCount">
            <property name="max" value="6"/>
            <property name="maxForVoid" value="4"/>
        </module>

        <!-- readability -->
        <module name="NeedBraces"/>
        <module name="AvoidNestedBlocks"/>
        <module name="EmptyBlock"><property name="option" value="text"/></module>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="OneStatementPerLine"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="MagicNumber">
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreFieldDeclaration" value="true"/>
        </module>

        <!-- naming -->
        <module name="ConstantName"/>
        <module name="LocalFinalVariableName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="PackageName"/>
        <module name="ParameterName"/>
        <module name="StaticVariableName"/>
        <module name="TypeName"/>

        <!-- imports -->
        <module name="AvoidStarImport"/>
        <module name="IllegalImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
    </module>
</module>
